# =====================================================================
# GourmetOS Restaurant Management System - Server Environment Template
# =====================================================================

# Server Port (Default: 4001)
PORT=4001

# Environment Mode: 'production' or 'development'
NODE_ENV=production

# Security: JWT Secret for auth tokens (REQUIRED in production)
# Generate a secure key using: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_secret_token_in_production_min_32_chars

# Token Lifespan (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Database Path (Default: ./restaurant.db)
# For Render Persistent Disk: /data/restaurant.db
DB_PATH=./restaurant.db

# Uploads Directory for receipts, product images, waste photos
# For Render Persistent Disk: /data/uploads
UPLOAD_DIR=./uploads

# Allowed Cross-Origin Origins (comma-separated if multiple domains)
# Example: https://myrestaurant.com,https://pos.myrestaurant.com
CLIENT_ORIGIN=http://localhost:5180,http://localhost:5173,http://localhost:4001

# =====================================================================
# Cloud Backup & Disaster Recovery (Optional - Free Supabase Storage)
# Backs up restaurant.db automatically on data writes and server shutdown
# =====================================================================
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=restaurant-backups
CLOUD_SYNC_INTERVAL_MS=300000
